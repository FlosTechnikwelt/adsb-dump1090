<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ADS-B</title>
    <style>
        body { font-family: sans-serif; margin: 2em; background-color: #f4f4f9; color: #333; }
        h1 { color: #4a4a4a; }
        table { width: 100%; border-collapse: collapse; margin-top: 1em; box-shadow: 0 2px 3px rgba(0,0,0,0.1); }
        th, td { padding: 12px 15px; text-align: left; border-bottom: 1px solid #ddd; }
        thead { background-color: #007bff; color: white; }
        tbody tr:nth-of-type(even) { background-color: #f9f9f9; }
        tbody tr:hover { background-color: #f1f1f1; }
        p { font-size: 0.9em; color: #666; }
        #update-time { font-weight: bold; }
    </style>
    <script>
        // Funktion zum asynchronen Abrufen und Aktualisieren der Daten
        function updateAircraftData() {
            fetch('/api/aircraft')
                .then(response => response.json())
                .then(data => {
                    const tableBody = document.getElementById('aircraft-table-body');
                    const updateTime = document.getElementById('update-time');
                    
                    // Aktualisiere die Zeit der letzten Aktualisierung
                    updateTime.textContent = data.lastUpdate;

                    // Leere die Tabelle
                    tableBody.innerHTML = '';

                    // Fülle die Tabelle mit neuen Daten
                    data.aircrafts.forEach(ac => {
                        const row = tableBody.insertRow();
                        row.insertCell().textContent = ac.flight.trim();
                        row.insertCell().textContent = ac.hex;
                        row.insertCell().textContent = ac.altitude;
                        row.insertCell().textContent = ac.speed;
                        row.insertCell().textContent = `${ac.lat.toFixed(4)}, ${ac.lon.toFixed(4)}`;
                        row.insertCell().textContent = new Date(ac.timestamp * 1000).toLocaleTimeString();
                    });
                })
                .catch(error => console.error('Fehler beim Abrufen der Daten:', error));
        }

        // Aktualisiere die Daten alle 5 Sekunden
        document.addEventListener('DOMContentLoaded', () => {
            updateAircraftData(); // Erste Aktualisierung sofort
            setInterval(updateAircraftData, 5000);
        });
    </script>
</head>
<body>
    <h1>ADS-B</h1>
    <p>Letzte Aktualisierung: <span id="update-time"><%= lastUpdate %></span> (wird alle 5s aktualisiert)</p>

    <% if (aircrafts.length > 0) { %>
        <table>
            <thead>
                <tr>
                    <th>Flugnummer</th>
                    <th>Hex-Code</th>
                    <th>Höhe (Fuß)</th>
                    <th>Geschwindigkeit (Knoten)</th>
                    <th>Position (Lat/Lon)</th>
                    <th>Zuletzt gesehen</th>
                </tr>
            </thead>
            <tbody id="aircraft-table-body">
                <% aircrafts.forEach(ac => { %>
                    <tr>
                        <td><%= ac.flight.trim() %></td>
                        <td><%= ac.hex %></td>
                        <td><%= ac.altitude %></td>
                        <td><%= ac.speed %></td>
                        <td><%= ac.lat.toFixed(4) %>, <%= ac.lon.toFixed(4) %></td>
                        <td><%= new Date(ac.timestamp * 1000).toLocaleTimeString() %></td>
                    </tr>
                <% }); %>
            </tbody>
        </table>
    <% } else { %>
        <p>Warte auf Datenstrom...</p>
    <% } %>

</body>
</html>
