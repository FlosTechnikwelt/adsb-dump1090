<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ADSB Dump1090 Viewer</title>
    <link rel="stylesheet" href="/assets/css/style.css">
</head>
<body>
    <h1>ADSB Dump1090 Viewer</h1>
    <div id="aircraft-container">
        <p>Fetching aircraft data...</p>
    </div>

    <script>
        const aircraftContainer = document.getElementById('aircraft-container');

        async function fetchAircraftData() {
            try {
                const response = await fetch('/api/aircraft');
                if (!response.ok) {
                    aircraftContainer.innerHTML = `<p>Error fetching data: ${response.statusText}</p>`;
                    return;
                }
                const data = await response.json();

                let html = `<h2>Aircraft Found: ${data.aircraft.length}</h2>`;
                html += '<pre>' + JSON.stringify(data.aircraft, null, 2) + '</pre>';

                aircraftContainer.innerHTML = html;

            } catch (error) {
                console.error('Error:', error);
                aircraftContainer.innerHTML = '<p>Could not connect to the backend. Is the server running?</p>';
            }
        }

        // Fetch data immediately and then every 5 seconds
        fetchAircraftData();
        setInterval(fetchAircraftData, 5000);
    </script>
</body>
</html>