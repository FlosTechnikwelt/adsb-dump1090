{
  "name": "desy-adsb",
  "version": "1.6.2",
  "description": "Dies ist ein Web-App zur Visualisierung von ADS-B Daten, die von dump1090 gesammelt wurden. Es speichert historische Flugdaten in einer SQLite-Datenbank und stellt sie über eine Express.js-Server bereit.",
  "main": "index.js",
  "scripts": {
    "start": "node server.js",
    "start:dev": "nodemon server.js",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "ADSB",
    "Dashboard",
    "Express",
    "Chart.js",
    "SQLite",
    "DESY",
    "ADS-B",
    "Aircraft",
    "Flight Tracking",
    "Aviation",
    "Real-time Data",
    "Data Visualization",
    "Aircraft Tracking",
    "Local Tracking",
    "Flight Data",
    "1090 MHz",
    "1090",
    "API-Dump1090",
    "FlightAware Local API"
  ],
  "author": "Florian Linde (DESY IT Azubi)",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "axios": "^1.13.2",
    "chart.js": "^4.5.1",
    "chartjs-adapter-date-fns": "^3.0.0",
    "date-fns": "^4.1.0",
    "express": "^5.1.0",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "nodemon": "^3.1.11",
    "prettier": "^3.7.4"
  }
}
